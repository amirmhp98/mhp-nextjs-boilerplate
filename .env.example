# Copy to .env and adjust. Every variable here is validated at boot by src/lib/env.ts.

# ─── Database ────────────────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml (npm run db:up).
# Pool tuning goes in the query string: ?connection_limit=10&pool_timeout=30
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Session lifetime in days.
SESSION_MAX_AGE_DAYS=7
# "true" bypasses login and serves a mock admin, so the app runs without a
# database (UI work, component previews). Refused when NODE_ENV=production.
SKIP_AUTH=false

# ─── Locale profile (boilerplate only) ───────────────────────────────────────
# Overrides FALLBACK_LOCALE in src/lib/locale.ts so the boilerplate can be built
# and tested in either language. A project has one language, chosen by
# `setup.sh --locale`, and setup.sh removes this block. Inlined at build time:
# restart `npm run dev` / rebuild after changing it.
#   fa  Persian, RTL, Jalali calendar, Persian digits, Asia/Tehran, IRR
#   en  English, LTR, Gregorian calendar, Latin digits, UTC, USD
NEXT_PUBLIC_LOCALE=fa

# ─── Logging ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# "true" logs every Prisma query (development only)
PRISMA_LOG_QUERIES=false

# ─── Tests (optional) ────────────────────────────────────────────────────────
# Credentials used by e2e/auth.setup.ts; defaults to the seeded admin.
# TEST_USERNAME=admin
# TEST_PASSWORD=admin123

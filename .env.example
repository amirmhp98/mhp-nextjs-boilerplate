# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (prisma/schema.prisma).
# Required unless SKIP_AUTH=true.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# "true" bypasses authentication and serves a mock admin user, so the app runs
# without a database (UI work, component previews, e2e without a DB).
# Never enable in production.
SKIP_AUTH=false

# Session lifetime in days (default: 7).
# SESSION_MAX_AGE_DAYS=7

# ─── Locale profile (build-time) ─────────────────────────────────────────────
# Selects the active profile from src/lib/locale.ts. NEXT_PUBLIC_* values are
# inlined at build time, so restart `npm run dev` / rebuild after changing it.
# e2e/playwright.config.ts reads the same variable for browser locale/time zone.
#   fa  Persian, RTL, Jalali calendar, Persian digits, Asia/Tehran, IRR (default)
#   en  English, LTR, Gregorian calendar, Latin digits, UTC, USD
NEXT_PUBLIC_LOCALE=fa

# ─── Optional ────────────────────────────────────────────────────────────────
# LOG_LEVEL=info              # pino level for src/lib/logger.ts
# PRISMA_LOG_QUERIES=false    # "true" logs every Prisma query
# TEST_USERNAME=admin         # credentials used by e2e/auth.setup.ts
# TEST_PASSWORD=admin123
